{
  "name": "offerloop-ad-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Prompt-driven ad video pipeline: Figma + Higgsfield + Remotion",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render",
    "storyboard": "node tools/storyboard/server.mjs",
    "appstore": "node tools/appstore/render.mjs",
    "decks": "(sleep 3 && open http://localhost:3222/deck-viewer.html) & slidev decks/classroom-demo/slides.md --port 3222",
    "decks:export": "slidev export decks/classroom-demo/slides.md --format pptx --output out/classroom-demo.pptx",
    "carousel": "node tools/carousel/server.mjs",
    "carousel:restyle": ".venv-key/bin/python tools/carousel/restyle.py public/assets/carousels/ig-launch public/assets/carousels/ig-launch-blue",
    "carousel:cards": "node tools/carousel/render.mjs",
    "carousel:cover": ".venv-key/bin/python tools/carousel/cover.py"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.487",
    "@remotion/transitions": "^4.0.489",
    "d3-geo": "^3.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@slidev/cli": "^52.18.0",
    "@slidev/theme-default": "^0.25.0",
    "@types/d3-geo": "^3.1.1",
    "@types/react": "^19.0.0",
    "@types/topojson-client": "^3.1.5",
    "playwright-chromium": "^1.61.1",
    "typescript": "^5.5.0"
  }
}
